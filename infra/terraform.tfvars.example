# 복사해서 terraform.tfvars로 저장한 뒤 값을 채우세요. (terraform.tfvars는 Git에 올리지 않음)
github_repo = "vitavincent402/SafeTravel-EKS"

# 계정에 GitHub OIDC 공급자가 이미 있으면 false
create_github_oidc_provider = true

# 도메인이 있으면 HTTPS. 없으면 둘 다 비워 두기
domain_name      = ""
hosted_zone_name = ""

# true: terraform apply 한 번에 파이프라인까지 실행해서 앱이 떠 있는 상태로 끝남 (강사님 조건)
# false: 인프라만 만들고 멈춤 (파이프라인 없이 인프라만 확인할 때)
run_bootstrap_deploy = true

# 저장소가 불변 주체를 쓰면: gh api repos/<repo>/actions/oidc/customization/sub 의 sub_claim_prefix
# github_oidc_sub_prefix = ""

# 팀원 클러스터 권한 (IAM 사용자는 scripts/create-team-users.ps1 로 먼저 만들어 둔다)
