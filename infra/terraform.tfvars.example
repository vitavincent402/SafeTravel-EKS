# 복사해서 terraform.tfvars로 저장한 뒤 값을 채우세요. (terraform.tfvars는 Git에 올리지 않음)
github_repo = "vitavincent402/SafeTravel-EKS"

# 계정에 GitHub OIDC 공급자가 이미 있으면 false
create_github_oidc_provider = true

# 도메인이 있으면 HTTPS. 없으면 둘 다 비워 두기
domain_name      = ""
hosted_zone_name = ""
# 주소를 더 쓰려면 (예: www). 인증서·A 레코드·Ingress에 같이 들어감. 같은 호스팅 영역 안의 이름이어야 함
# extra_domain_names = ["www.travelsafe.click"]

# 로그인(Cognito): persistent/ 를 한 번 apply한 뒤 그 출력값을 넣는다 (persistent/README.md 참고)
# cognito_user_pool_id = ""
# cognito_client_id    = ""
# cognito_login_domain = ""

# true: terraform apply 한 번에 파이프라인까지 실행해서 앱이 떠 있는 상태로 끝남 (강사님 조건)
# false: 인프라만 만들고 멈춤 (파이프라인 없이 인프라만 확인할 때)
run_bootstrap_deploy = true

# 저장소가 불변 주체를 쓰면: gh api repos/<repo>/actions/oidc/customization/sub 의 sub_claim_prefix
# github_oidc_sub_prefix = ""

# 팀원 클러스터 권한 (IAM 사용자는 scripts/create-team-users.ps1 로 먼저 만들어 둔다)
# team_members = {
#   db  = { arn = "arn:aws:iam::<계정ID>:user/keeper-db",    level = "developer" }
#   soc = { arn = "arn:aws:iam::<계정ID>:user/keeper-soc",    level = "developer" }
#   web = { arn = "arn:aws:iam::<계정ID>:user/keeper-web",    level = "viewer" }
#   red = { arn = "arn:aws:iam::<계정ID>:user/keeper-red", level = "tester" }   # tester = 조회 + keeper 네임스페이스 파드 생성만(공격 시험용)
# }

# 가용성 감시 (monitoring.tf, WEB 담당). 첫 apply에서는 끄고, 따로 한 번 켜서 시험한 뒤 리허설부터 켠다
# monitoring_enabled = true
# alert_topic_arn    = "<persistent 출력 alert_topic_arn>"
